# Names only — copy to .env and fill in. Never commit real values.

# Discord
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
DISCORD_REIBLAST_ROLE_ID=
DISCORD_VERIFY_CHANNEL_ID=
DISCORD_STAFF_ROLE_ID=
DISCORD_STAFF_LOG_CHANNEL_ID=

# AI Q&A
# Support forum channel and its three tags: Support, Resolved, Needs Staff (all four IDs differ)
DISCORD_SUPPORT_FORUM_ID=
DISCORD_TAG_SUPPORT_ID=
DISCORD_TAG_RESOLVED_ID=
DISCORD_TAG_NEEDS_STAFF_ID=
# Locked text channel that is the parent of private support threads (the bot never posts top-level there)
DISCORD_SUPPORT_CHANNEL_ID=
# Role pinged on escalation; also the role that can see/close private threads
DISCORD_SUPPORT_ROLE_ID=
ANTHROPIC_API_KEY=

# REIblast server (base URL of the app, no trailing path)
REIBLAST_SERVER_URL=

# bot -> server: sent as the x-reiblast-discord-secret header
DISCORD_BOT_INBOUND_SECRET=
# server -> bot: checked as the x-reiblast-bot-secret header on /revoke (must differ from the one above)
DISCORD_BOT_OUTBOUND_SECRET=

# Optional, previews only: Vercel "Protection Bypass for Automation" secret (sent as x-vercel-protection-bypass).
# Leave unset/empty in production.
VERCEL_PROTECTION_BYPASS_SECRET=

# Shown to users in refusal messages
SUPPORT_PHONE=

# Optional (PORT is injected by Railway)
PORT=3000
LOG_LEVEL=info
